# Copy to .env and fill in. Every variable here is parsed by src/server/env.ts
# at boot — a missing or malformed value stops the server with an explanation.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Required. The run log lives here. Matches docker-compose.yml; start it with
# `docker compose up -d`, then apply the schema with `pnpm db:migrate`.
DATABASE_URL=postgresql://durable_run:durable_run@localhost:5432/durable_run

# Optional. Sent to OpenRouter as the attribution referer.
APP_URL=http://localhost:3000
